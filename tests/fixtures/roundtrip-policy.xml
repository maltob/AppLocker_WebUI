<?xml version="1.0" encoding="utf-8"?>
<AppLockerPolicy Version="1">
  <RuleCollection Type="Exe" EnforcementMode="AuditOnly">
    <FilePathRule Id="11111111-1111-4111-8111-111111111111" Name="Contoso tools" Description="Program Files tools" UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions>
        <FilePathCondition Path="%PROGRAMFILES%\Contoso\*" />
      </Conditions>
      <Exceptions>
        <FilePathCondition Path="%PROGRAMFILES%\Contoso\legacy.exe" />
      </Exceptions>
    </FilePathRule>
    <FilePublisherRule Id="22222222-2222-4222-8222-222222222222" Name="Contoso signed binaries" Description="Signed Contoso binaries" UserOrGroupSid="S-1-1-0" Action="Allow">
      <Conditions>
        <FilePublisherCondition PublisherName="O=Contoso Ltd, C=US" ProductName="Contoso Suite" BinaryName="*">
          <BinaryVersionRange LowSection="1.0.0.0" HighSection="*" />
        </FilePublisherCondition>
      </Conditions>
      <Exceptions>
        <FilePublisherCondition PublisherName="O=Contoso Ltd, C=US" ProductName="Contoso Suite" BinaryName="legacy.exe">
          <BinaryVersionRange LowSection="0.0.0.0" HighSection="*" />
        </FilePublisherCondition>
      </Exceptions>
    </FilePublisherRule>
    <RuleCollectionExtensions>
      <ThresholdExtensions>
        <Services EnforcementMode="Enabled" />
      </ThresholdExtensions>
      <RedstoneExtensions>
        <SystemApps Allow="Enabled" />
      </RedstoneExtensions>
    </RuleCollectionExtensions>
  </RuleCollection>
  <RuleCollection Type="Msi" EnforcementMode="Enabled">
    <FileHashRule Id="33333333-3333-4333-8333-333333333333" Name="Installer package" Description="Known installer" UserOrGroupSid="S-1-5-32-544" Action="Allow">
      <Conditions>
        <FileHashCondition>
          <FileHash Type="SHA256" Data="0xAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA" SourceFileName="setup.msi" SourceFileLength="1024" />
        </FileHashCondition>
      </Conditions>
    </FileHashRule>
  </RuleCollection>
  <PolicyExtensions>
    <ThresholdExtensions>
      <Services EnforcementMode="Enabled" />
    </ThresholdExtensions>
  </PolicyExtensions>
</AppLockerPolicy>
